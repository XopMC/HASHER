{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-x64-base", "hidden": true, "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "HASHER_EXPECT_ARCH": "^(AMD64|amd64|x86_64)$", "HASHER_BUILD_TESTS": "ON"
      }
    },
    { "name": "win-x64-clang-debug", "inherits": "win-x64-base", "binaryDir": "${sourceDir}/tests/build/win-x64-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "win-x64-clang-release", "inherits": "win-x64-base", "binaryDir": "${sourceDir}/tests/build/win-x64-release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "win-x64-clang-pgo-generate", "inherits": "win-x64-base", "binaryDir": "${sourceDir}/tests/build/win-x64-pgo-generate", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "HASHER_PGO": "GENERATE" } },
    { "name": "win-x64-clang-pgo-use", "inherits": "win-x64-base", "binaryDir": "${sourceDir}/tests/build/win-x64-pgo-use", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "HASHER_PGO": "USE", "HASHER_PGO_PROFILE": "${sourceDir}/tests/profiles/win-x64.profdata" } },
    {
      "name": "win-arm64-clang-release", "inherits": "win-x64-base", "binaryDir": "${sourceDir}/tests/build/win-arm64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_SYSTEM_NAME": "Windows", "CMAKE_SYSTEM_PROCESSOR": "ARM64", "CMAKE_C_COMPILER_TARGET": "aarch64-pc-windows-msvc", "CMAKE_CXX_COMPILER_TARGET": "aarch64-pc-windows-msvc", "HASHER_EXPECT_ARCH": "^(ARM64|arm64|aarch64)$" }
    },
    { "name": "win-arm64-clang-pgo-generate", "inherits": "win-arm64-clang-release", "binaryDir": "${sourceDir}/tests/build/win-arm64-pgo-generate", "cacheVariables": { "HASHER_PGO": "GENERATE" } },
    { "name": "win-arm64-clang-pgo-use", "inherits": "win-arm64-clang-release", "binaryDir": "${sourceDir}/tests/build/win-arm64-pgo-use", "cacheVariables": { "HASHER_PGO": "USE", "HASHER_PGO_PROFILE": "${sourceDir}/tests/profiles/win-arm64.profdata" } },
    {
      "name": "linux-base", "hidden": true, "generator": "Ninja",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_MAKE_PROGRAM": "ninja", "HASHER_BUILD_TESTS": "ON" }
    },
    { "name": "linux-x64-clang-mold-debug", "inherits": "linux-base", "binaryDir": "${sourceDir}/tests/build/linux-x64-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "HASHER_EXPECT_ARCH": "^(x86_64|amd64)$" } },
    { "name": "linux-x64-clang-mold-release", "inherits": "linux-base", "binaryDir": "${sourceDir}/tests/build/linux-x64-release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "HASHER_EXPECT_ARCH": "^(x86_64|amd64)$" } },
    { "name": "linux-x64-clang-mold-pgo-generate", "inherits": "linux-x64-clang-mold-release", "binaryDir": "${sourceDir}/tests/build/linux-x64-pgo-generate", "cacheVariables": { "HASHER_PGO": "GENERATE" } },
    { "name": "linux-x64-clang-mold-pgo-use", "inherits": "linux-x64-clang-mold-release", "binaryDir": "${sourceDir}/tests/build/linux-x64-pgo-use", "cacheVariables": { "HASHER_PGO": "USE", "HASHER_PGO_PROFILE": "${sourceDir}/tests/profiles/linux-x64.profdata" } },
    { "name": "linux-arm64-clang-mold-release", "inherits": "linux-base", "binaryDir": "${sourceDir}/tests/build/linux-arm64-release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "HASHER_EXPECT_ARCH": "^(aarch64|arm64)$", "HASHER_ENABLE_LTO": "OFF" } },
    { "name": "linux-arm64-clang-mold-pgo-generate", "inherits": "linux-arm64-clang-mold-release", "binaryDir": "${sourceDir}/tests/build/linux-arm64-pgo-generate", "cacheVariables": { "HASHER_PGO": "GENERATE" } },
    { "name": "linux-arm64-clang-mold-pgo-use", "inherits": "linux-arm64-clang-mold-release", "binaryDir": "${sourceDir}/tests/build/linux-arm64-pgo-use", "cacheVariables": { "HASHER_PGO": "USE", "HASHER_PGO_PROFILE": "${sourceDir}/tests/profiles/linux-arm64.profdata" } },
    {
      "name": "android-arm64-termux-release", "generator": "Ninja", "binaryDir": "${sourceDir}/tests/build/android-arm64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "$env{PREFIX}/bin/clang", "CMAKE_CXX_COMPILER": "$env{PREFIX}/bin/clang++", "HASHER_EXPECT_ARCH": "^(aarch64|arm64)$", "HASHER_ENABLE_LTO": "OFF", "HASHER_BUILD_TESTS": "ON" }
    },
    { "name": "android-arm64-termux-pgo-generate", "inherits": "android-arm64-termux-release", "binaryDir": "${sourceDir}/tests/build/android-arm64-pgo-generate", "cacheVariables": { "HASHER_PGO": "GENERATE" } },
    { "name": "android-arm64-termux-pgo-use", "inherits": "android-arm64-termux-release", "binaryDir": "${sourceDir}/tests/build/android-arm64-pgo-use", "cacheVariables": { "HASHER_PGO": "USE", "HASHER_PGO_PROFILE": "${sourceDir}/tests/profiles/android-arm64.profdata" } },
    {
      "name": "macos-arm64-clang-release", "generator": "Ninja", "binaryDir": "${sourceDir}/tests/build/macos-arm64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_OSX_ARCHITECTURES": "arm64", "HASHER_EXPECT_ARCH": "^(arm64|aarch64)$", "HASHER_BUILD_TESTS": "ON" }
    },
    { "name": "macos-arm64-clang-pgo-generate", "inherits": "macos-arm64-clang-release", "binaryDir": "${sourceDir}/tests/build/macos-arm64-pgo-generate", "cacheVariables": { "HASHER_PGO": "GENERATE" } },
    { "name": "macos-arm64-clang-pgo-use", "inherits": "macos-arm64-clang-release", "binaryDir": "${sourceDir}/tests/build/macos-arm64-pgo-use", "cacheVariables": { "HASHER_PGO": "USE", "HASHER_PGO_PROFILE": "${sourceDir}/tests/profiles/macos-arm64.profdata" } }
  ],
  "buildPresets": [
    { "name": "win-x64-clang-debug", "configurePreset": "win-x64-clang-debug" }, { "name": "win-x64-clang-release", "configurePreset": "win-x64-clang-release" },
    { "name": "win-x64-clang-pgo-generate", "configurePreset": "win-x64-clang-pgo-generate" }, { "name": "win-x64-clang-pgo-use", "configurePreset": "win-x64-clang-pgo-use" },
    { "name": "linux-x64-clang-mold-debug", "configurePreset": "linux-x64-clang-mold-debug" }, { "name": "linux-x64-clang-mold-release", "configurePreset": "linux-x64-clang-mold-release" },
    { "name": "linux-x64-clang-mold-pgo-generate", "configurePreset": "linux-x64-clang-mold-pgo-generate" }, { "name": "linux-x64-clang-mold-pgo-use", "configurePreset": "linux-x64-clang-mold-pgo-use" },
    { "name": "linux-arm64-clang-mold-release", "configurePreset": "linux-arm64-clang-mold-release" }, { "name": "android-arm64-termux-release", "configurePreset": "android-arm64-termux-release" }, { "name": "macos-arm64-clang-release", "configurePreset": "macos-arm64-clang-release" },
    { "name": "linux-arm64-clang-mold-pgo-generate", "configurePreset": "linux-arm64-clang-mold-pgo-generate" }, { "name": "linux-arm64-clang-mold-pgo-use", "configurePreset": "linux-arm64-clang-mold-pgo-use" },
    { "name": "macos-arm64-clang-pgo-generate", "configurePreset": "macos-arm64-clang-pgo-generate" }, { "name": "macos-arm64-clang-pgo-use", "configurePreset": "macos-arm64-clang-pgo-use" },
    { "name": "win-arm64-clang-release", "configurePreset": "win-arm64-clang-release" }, { "name": "win-arm64-clang-pgo-generate", "configurePreset": "win-arm64-clang-pgo-generate" }, { "name": "win-arm64-clang-pgo-use", "configurePreset": "win-arm64-clang-pgo-use" }
  ],
  "testPresets": [
    { "name": "win-x64-clang-release", "configurePreset": "win-x64-clang-release", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-clang-mold-release", "configurePreset": "linux-x64-clang-mold-release", "output": { "outputOnFailure": true } }
  ]
}
